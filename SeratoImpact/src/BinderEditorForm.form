<?xml version='1.0' encoding='UTF-8'?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="BinderEditorForm">
  <grid id="editor_root" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="9" vgap="9">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints>
      <xy x="20" y="20" width="500" height="210"/>
    </constraints>
    <properties><background color="-724500"/><opaque value="true"/></properties>
    <border type="none"/>
    <children>
      <component id="label_txtName" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Binder name"/>
        <foreground color="-10204356"/></properties>
      </component>
      <component id="field_txtName" binding="txtName" class="javax.swing.JTextField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="label_txtDescription" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Description"/>
        <foreground color="-10204356"/></properties>
      </component>
      <component id="field_txtDescription" binding="txtDescription" class="javax.swing.JTextField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="label_chkPublic" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Visibility"/>
        <foreground color="-10204356"/></properties>
      </component>
      <component id="field_chkPublic" binding="chkPublic" class="javax.swing.JCheckBox">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Public: buyers can view"/>
        <background color="-724500"/></properties>
      </component>
    </children>
  </grid>
</form>
