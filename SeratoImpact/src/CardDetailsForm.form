<?xml version='1.0' encoding='UTF-8'?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="CardDetailsForm">
  <grid id="details_root" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="18" vgap="12">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints>
      <xy x="20" y="20" width="670" height="405"/>
    </constraints>
    <properties>
      <background color="-724500"/>
      <preferredSize width="670" height="405"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="card_details_image" class="javax.swing.JLabel" binding="lblCardImage">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="230" height="310"/>
          </grid>
        </constraints>
        <properties>
          <background color="-1710110"/>
          <opaque value="true"/>
          <horizontalAlignment value="0"/>
          <verticalAlignment value="0"/>
          <text value="NO IMAGE"/>
        </properties>
      </component>
      <grid id="detail_fields" layout-manager="GridLayoutManager" binding="infoPanel" row-count="10" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="10">
